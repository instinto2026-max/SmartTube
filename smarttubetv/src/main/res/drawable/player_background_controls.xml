<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign: darken only the bottom, where the controls are. The video stays visible above. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:centerY="0.4"
                android:startColor="#F2000000"
                android:centerColor="#B3000000"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</selector>
